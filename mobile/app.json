{
  "expo": {
    "name": "Vicente · Números",
    "slug": "vicente-numeros",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vicentenumeros",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "cl.tuparrilla.app",
      "icon": "./assets/images/icon-ios.png",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "cl.vicentepareja.numeros",
      "adaptiveIcon": {
        "backgroundColor": "#16181a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16181a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Para abrir la app con tu cara, igual que el resto del teléfono."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir las fotos y videos que vas a publicar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b7ba4d91-a97c-456f-9f35-504c39a93dea"
      }
    },
    "owner": "vicentepareja",
    "updates": {
      "url": "https://u.expo.dev/b7ba4d91-a97c-456f-9f35-504c39a93dea"
    }
  }
}
