{
  "name": "portafolio-page",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "db:setup": "npm run db:migrate:local && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrar.ts",
    "db:migrate:local": "dotenv -e .env.local -- tsx scripts/migrar.ts",
    "db:baseline": "dotenv -e .env.local -- tsx scripts/baseline.ts",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed.ts",
    "demo:seed": "dotenv -e .env.local -- tsx scripts/demo-data.ts seed",
    "demo:clear": "dotenv -e .env.local -- tsx scripts/demo-data.ts clear",
    "analytics:reset": "dotenv -e .env.local -- tsx scripts/reset-analytics.ts",
    "analytics:check": "dotenv -e .env.local -- tsx scripts/verify.ts",
    "blobs:auditar": "dotenv -e .env.local -- tsx scripts/blob-audit.ts",
    "cuentas:backfill": "dotenv -e .env.local -- tsx scripts/backfill-cuentas.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ai": "^7.0.143",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
